{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/create-checkout-session.js": {
      "includeFiles": "employees/website-designer-employee/member-projects/bouke/store/products.json"
    },
    "api/stripe-webhook.js": {
      "includeFiles": "employees/website-designer-employee/member-projects/bouke/store/products.json"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/employees/website-designer-employee/member-projects/bouke/dist/index.html"
    },
    {
      "source": "/index.html",
      "destination": "/employees/website-designer-employee/member-projects/bouke/dist/index.html"
    },
    {
      "source": "/shop.html",
      "destination": "/employees/website-designer-employee/member-projects/bouke/dist/shop.html"
    },
    {
      "source": "/clothing.html",
      "destination": "/employees/website-designer-employee/member-projects/bouke/dist/clothing.html"
    },
    {
      "source": "/success.html",
      "destination": "/employees/website-designer-employee/member-projects/bouke/dist/success.html"
    },
    {
      "source": "/cancel.html",
      "destination": "/employees/website-designer-employee/member-projects/bouke/dist/cancel.html"
    },
    {
      "source": "/styles.css",
      "destination": "/employees/website-designer-employee/member-projects/bouke/dist/styles.css"
    },
    {
      "source": "/app.js",
      "destination": "/employees/website-designer-employee/member-projects/bouke/dist/app.js"
    },
    {
      "source": "/shop.js",
      "destination": "/employees/website-designer-employee/member-projects/bouke/dist/shop.js"
    },
    {
      "source": "/clothing.js",
      "destination": "/employees/website-designer-employee/member-projects/bouke/dist/clothing.js"
    },
    {
      "source": "/nav.js",
      "destination": "/employees/website-designer-employee/member-projects/bouke/dist/nav.js"
    },
    {
      "source": "/products.json",
      "destination": "/employees/website-designer-employee/member-projects/bouke/store/products.json"
    },
    {
      "source": "/images/:file",
      "destination": "/employees/website-designer-employee/member-projects/bouke/dist/images/:file"
    }
  ]
}
