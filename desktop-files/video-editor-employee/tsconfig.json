{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.tsx",
    "src/**/*.ts",
    "jobs/**/motion/*.tsx",
    "examples/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "jobs/**/revisions/**"
  ]
}
