{
  "schema": "ai-employee/1",
  "slug": "lead-gen-employee",
  "name": "Lead Gen Employee",
  "role": "Lead list building",
  "version": "1.0.0",
  "standard": "1.5",
  "repository": "https://github.com/boukess/AI-employee",
  "license": "MIT",
  "requires": {
    "node": ">=18",
    "python": ">=3.9",
    "harness": [
      "claude-code",
      "openclaw",
      "hermes",
      "opencode",
      "grok-bot",
      "codex",
      "antigravity",
      "pi",
      "cline",
      "qwen-code",
      "deepseek"
    ]
  },
  "connections": [
    {
      "capability": "people.search",
      "providers": [
        "apollo",
        "hunter",
        "clay",
        "zoominfo"
      ],
      "required": false,
      "readonly": true
    },
    {
      "capability": "places.search",
      "providers": [
        "google-places"
      ],
      "required": false,
      "readonly": true
    },
    {
      "capability": "email.verify",
      "providers": [
        "hunter",
        "instantly"
      ],
      "required": false,
      "readonly": true
    },
    {
      "capability": "crm.push",
      "providers": [
        "instantly",
        "gohighlevel"
      ],
      "required": false,
      "readonly": false
    },
    {
      "capability": "web.fetch",
      "providers": [
        "shell-fetch",
        "harness-fetch"
      ],
      "required": false,
      "readonly": true
    }
  ],
  "routines": [
    {
      "id": "leadgen-desk-setup",
      "days": "first-weekday",
      "fire": "11:00",
      "window_start": "10:45",
      "window_end": "15:00",
      "period_key": "YYYY-MM",
      "budget": "45 min",
      "browser": "light"
    },
    {
      "id": "leadgen-icp-refresh",
      "days": "last-weekday",
      "fire": "15:00",
      "window_start": "14:45",
      "window_end": "18:30",
      "period_key": "YYYY-MM",
      "budget": "35 min",
      "browser": "light"
    },
    {
      "id": "leadgen-source-run",
      "days": "mon-fri",
      "fire": "06:45",
      "window_start": "06:30",
      "window_end": "09:45",
      "period_key": "YYYY-MM-DD",
      "budget": "25 min",
      "browser": "never"
    },
    {
      "id": "leadgen-desk-standup",
      "days": "mon-fri",
      "fire": "07:30",
      "window_start": "07:15",
      "window_end": "11:30",
      "period_key": "YYYY-MM-DD",
      "budget": "12 min",
      "browser": "never"
    },
    {
      "id": "leadgen-enrich-run",
      "days": "mon-fri",
      "fire": "08:30",
      "window_start": "08:15",
      "window_end": "12:00",
      "period_key": "YYYY-MM-DD",
      "budget": "35 min",
      "browser": "never"
    },
    {
      "id": "leadgen-qualify-run",
      "days": "mon-fri",
      "fire": "10:00",
      "window_start": "09:45",
      "window_end": "13:30",
      "period_key": "YYYY-MM-DD",
      "budget": "25 min",
      "browser": "never"
    },
    {
      "id": "leadgen-export-run",
      "days": "mon-fri",
      "fire": "14:00",
      "window_start": "13:45",
      "window_end": "17:30",
      "period_key": "YYYY-MM-DD",
      "budget": "20 min",
      "browser": "never"
    },
    {
      "id": "leadgen-push-run",
      "days": "fri",
      "fire": "16:00",
      "window_start": "15:45",
      "window_end": "19:00",
      "period_key": "YYYY-Www",
      "budget": "25 min",
      "browser": "never"
    }
  ],
  "files": {
    "kit": [
      "AGENTS.md",
      "CAPABILITIES.md",
      "CHANGELOG.md",
      "CONTRACT.md",
      "INSTALL-PROMPT.md",
      "README.md",
      "ROLE.md",
      "VERSION",
      ".gitignore",
      "employee.json",
      "recipes/BROWSER-RECIPES.md",
      "recipes/LEAD-DATA-RULES.md",
      "routines/**",
      "run/**",
      "scripts/**",
      "examples/**",
      "docs/**",
      "config/examples/**",
      "config/README.md",
      ".env.example",
      "data/samples/**",
      "data/exports/.gitkeep",
      "data/raw/.gitkeep",
      "WORK-CYCLE.md",
      "work-profile.json"
    ],
    "merge": [
      "SCHEDULE.md"
    ],
    "member": [
      "RELEASES.md",
      "state/**",
      "strategy/**",
      "briefs/**",
      "queue/**",
      "improvements/**",
      "archive/**",
      "progress/**",
      "experiments/**",
      "handoffs/**",
      "run/*.log",
      "recipes/*.json",
      "runlog.jsonl",
      "*-latest.md",
      ".installed.json",
      "PAUSED",
      "schedule-commands.txt",
      ".upgrade/**",
      "config/icp.json",
      "data/*.db",
      "data/*.db-*",
      "data/raw/*",
      "data/exports/*",
      ".env",
      "dashboard/**"
    ]
  },
  "notes": {
    "merge": "SCHEDULE.md carries the shape the kit ships and the days, windows and budgets the member owns. An upgrade reports a changed shape and never rewrites the row values.",
    "member": "Everything under member is the business the employee has been running: ICP, SQLite lead database, exports, ledgers and learned flows. An upgrade that overwrites any of it has destroyed work that exists nowhere else.",
    "recipes": "recipes/BROWSER-RECIPES.md and recipes/LEAD-DATA-RULES.md ship with the kit. Every recipes/*.json is learned on the member's own screens, so it is member data."
  }
}
