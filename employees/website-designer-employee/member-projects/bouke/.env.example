# Local names for `vercel dev`. Do not commit real keys.
# On Vercel, set the same names in the ai-employee project. See STORE-SETUP.md.

# Stripe secret key, test mode only. It must start with sk_test_
STRIPE_SECRET_KEY=

# Signing secret from Developers > Webhooks. It starts with whsec_
STRIPE_WEBHOOK_SECRET=

# Public site origin, no trailing slash. Success and cancel URLs are built from this.
SITE_URL=https://ai-employee-bouke1.vercel.app

# Not used. Checkout is hosted by Stripe, so the site does not load Stripe.js.
# STRIPE_PUBLISHABLE_KEY=
