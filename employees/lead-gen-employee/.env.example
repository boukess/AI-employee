# Copy to .env and fill in what you have. Everything is optional.
# The free path (OpenStreetMap sourcing + website crawl + local email checks) needs no keys.

# --- Sourcing ---
# Google Places API (New). Best coverage for local businesses. Paid per request.
GOOGLE_PLACES_API_KEY=
# Apollo.io. B2B companies + decision-maker contacts with emails. Search needs a paid plan; email reveals cost credits.
APOLLO_API_KEY=

# --- Contact finding / verification ---
# Hunter.io. Domain search finds named contacts + the company email pattern. Verifier checks deliverability.
HUNTER_API_KEY=

# --- Connectors ---
# Instantly.ai (API v2). Create a key in Settings > Integrations > API keys. Also used for email verification.
INSTANTLY_API_KEY=
# GoHighLevel. Private Integration token from Settings > Private Integrations (scopes: contacts.write, contacts.readonly).
GHL_API_KEY=
GHL_LOCATION_ID=
# GHL API version header. Leave as-is unless HighLevel tells you otherwise.
GHL_API_VERSION=2021-07-28

# --- Crawler identity (optional but polite) ---
# Shown in the User-Agent so site owners can see who crawled them.
CRAWLER_CONTACT=
